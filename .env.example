# TON Casino Configuration
# 
# IMPORTANT: Copy this file to .env and configure with your actual values
# The casino wallet address is where user deposits will be sent
# 
# Format: raw address format (workchain:account_id in hex)
# Example: 0:e430f363294077ba96e5e01a41d537c93b7c55c4b321f66877bfb36a25c34627
# 
# To convert from user-friendly format (EQ... or UQ...):
# - Use https://ton-address-converter.com/
# - Or TON SDK: Address.parse("EQ...").toRawString()
#
VITE_CASINO_WALLET_ADDRESS=0:e430f363294077ba96e5e01a41d537c93b7c55c4b321f66877bfb36a25c34627
